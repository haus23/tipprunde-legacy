    "unstorage": "^1.17.5",
    "valibot": "catalog:validation"
  },
  "devDependencies": {
    "@haus23/tipprunde-tsconfig": "workspace:^",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  }
}
